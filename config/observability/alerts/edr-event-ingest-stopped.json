{
  "alert": "EDR event ingest stopped",
  "alertType": "METRIC_BASED_ALERT",
  "description": "Hosts are checking in but the server accepted no events for 15 minutes: ingest is wedged or rejecting batches. The formula fires only while at least one host is online, so a fleet that is asleep does not page. A missing ingest sample counts as zero, which also covers delta export, where an idle counter sends nothing.",
  "ruleType": "threshold_rule",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "edr.events.ingested",
                "temporality": "",
                "timeAggregation": "rate",
                "spaceAggregation": "sum"
              }
            ],
            "disabled": true,
            "filter": {
              "expression": "service.name = 'rawtrail-server' AND deployment.environment = 'prod'"
            },
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 10000,
            "legend": ""
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "edr.enrolled.hosts",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": true,
            "filter": {
              "expression": "service.name = 'rawtrail-server' AND deployment.environment = 'prod'"
            },
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 10000,
            "legend": ""
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "C",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "edr.offline.hosts",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": true,
            "filter": {
              "expression": "service.name = 'rawtrail-server' AND deployment.environment = 'prod'"
            },
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 10000,
            "legend": ""
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "A == 0 ? B - C : 0",
            "disabled": false,
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 100,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 0,
          "targetUnit": "",
          "recoveryTarget": null,
          "matchType": "all_the_times",
          "op": "above",
          "channels": null
        }
      ]
    }
  },
  "labels": {
    "service": "rawtrail-server",
    "severity": "critical",
    "team": "edr"
  },
  "annotations": {
    "description": "edr.events.ingested has been zero for 15 minutes while hosts are online. Check the server logs for POST /api/events errors and the event store (MySQL, ClickHouse).",
    "summary": "EDR ingest stopped while {{$value}} hosts are online"
  },
  "disabled": false,
  "version": "v5",
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "1m"
    }
  },
  "schemaVersion": "v2alpha1",
  "notificationSettings": {
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": ["firing"]
    },
    "usePolicy": true
  }
}
