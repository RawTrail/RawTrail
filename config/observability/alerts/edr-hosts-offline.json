{
  "alert": "EDR hosts offline",
  "alertType": "METRIC_BASED_ALERT",
  "description": "More than 10% of enrolled hosts have not checked in within the offline threshold for 15 minutes: a fleet-wide connectivity problem, a broken ingress path, or a bad agent rollout. On a fleet of a few hosts, one sleeping laptop crosses 10%, so expect it there.",
  "ruleType": "threshold_rule",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "edr.offline.hosts",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": true,
            "filter": {
              "expression": "service.name = 'fleet-edr-server' AND deployment.environment = 'prod'"
            },
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 10000,
            "legend": ""
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "edr.enrolled.hosts",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": true,
            "filter": {
              "expression": "service.name = 'fleet-edr-server' AND deployment.environment = 'prod'"
            },
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 10000,
            "legend": ""
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "B > 0 ? A / B * 100 : 0",
            "disabled": false,
            "order": [
              {
                "key": {
                  "name": "__result",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                },
                "direction": "desc"
              }
            ],
            "limit": 100,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder",
      "unit": "percent"
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "target": 10,
          "targetUnit": "percent",
          "recoveryTarget": null,
          "matchType": "all_the_times",
          "op": "above",
          "channels": null
        }
      ]
    }
  },
  "labels": {
    "service": "fleet-edr-server",
    "severity": "warning",
    "team": "edr"
  },
  "annotations": {
    "description": "edr.offline.hosts / edr.enrolled.hosts has been above {{$threshold}}% for 15 minutes. Check the ingress path and recent agent rollouts.",
    "summary": "{{$value}}% of enrolled EDR hosts are offline"
  },
  "disabled": false,
  "version": "v5",
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "1m"
    }
  },
  "schemaVersion": "v2alpha1",
  "notificationSettings": {
    "renotify": {
      "enabled": false
    },
    "usePolicy": true
  }
}
